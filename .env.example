# Local development placeholders only. Replace credentials in .env before startup.
MARIADB_DATABASE=prestashop
MARIADB_USER=prestashop
MARIADB_PASSWORD=replace-with-local-app-password
MARIADB_ROOT_PASSWORD=replace-with-local-root-password
ADMIN_MAIL=admin@example.local
ADMIN_PASSWD=replace-with-local-admin-password
SHOP_BIND_ADDRESS=127.0.0.1
SHOP_PORT=8080

# Procurement is the current platform; legacy_retail is for historical QA only.
ORDENOWA_APP_MODE=procurement
# Supply these through the deployment's secret store; never commit real values.
# See modules/kuraneapush/PROVIDER_SETUP.md for generation and HTTPS acceptance.
ORDENOWA_PUSH_STORAGE_KEY=
ORDENOWA_PUSH_VAPID_PUBLIC_KEY=
ORDENOWA_PUSH_VAPID_PRIVATE_KEY=
ORDENOWA_PUSH_VAPID_SUBJECT=
